{
  "info": {
    "name": "NexusAPI",
    "description": "A scalable REST API with JWT Authentication and Role-Based Access Control (RBAC). Built with Express.js and MongoDB.\n\n## Getting Started\n1. Register a new user via **Auth > Register**\n2. Login via **Auth > Login** — the token is auto-saved\n3. Use Products endpoints (token is auto-attached)\n\n## Environment Variables\n- `base_url`: http://localhost:5000\n- `token`: Auto-set after login",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "Authentication endpoints — register, login, and get profile",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"user\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "register"]
            },
            "description": "Register a new user. Roles: `user` or `admin`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "    pm.test('Registration successful — token saved', function () {",
                  "        pm.expect(jsonData.token).to.be.a('string');",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Login with email and password. Returns a JWT token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('token', jsonData.token);",
                  "    pm.test('Login successful — token saved', function () {",
                  "        pm.expect(jsonData.token).to.be.a('string');",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "me"]
            },
            "description": "Get the currently authenticated user's profile. Requires a valid JWT token."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Products",
      "description": "Product CRUD endpoints — list, get, create, update, delete",
      "item": [
        {
          "name": "Get All Products",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/products?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "products"],
              "query": [
                { "key": "page", "value": "1", "description": "Page number" },
                { "key": "limit", "value": "10", "description": "Items per page" },
                { "key": "category", "value": "", "description": "Filter by category (electronics, clothing, books, food, sports, other)", "disabled": true },
                { "key": "search", "value": "", "description": "Search in name and description", "disabled": true },
                { "key": "sort", "value": "-createdAt", "description": "Sort field (prefix - for descending)", "disabled": true },
                { "key": "minPrice", "value": "", "description": "Minimum price filter", "disabled": true },
                { "key": "maxPrice", "value": "", "description": "Maximum price filter", "disabled": true }
              ]
            },
            "description": "Get a paginated list of all products. Supports filtering by category, price range, search, and sorting."
          },
          "response": []
        },
        {
          "name": "Get Single Product",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/products/:id",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "products", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "PRODUCT_ID_HERE",
                  "description": "MongoDB ObjectId of the product"
                }
              ]
            },
            "description": "Get a single product by its ID."
          },
          "response": []
        },
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Wireless Headphones\",\n  \"description\": \"Premium noise-canceling wireless headphones with 30hr battery life\",\n  \"price\": 149.99,\n  \"category\": \"electronics\",\n  \"inStock\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/products",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "products"]
            },
            "description": "Create a new product. Any authenticated user can create products."
          },
          "response": []
        },
        {
          "name": "Update Product",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Headphones\",\n  \"price\": 129.99,\n  \"inStock\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/products/:id",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "products", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "PRODUCT_ID_HERE",
                  "description": "MongoDB ObjectId of the product"
                }
              ]
            },
            "description": "Update a product. Only the product owner or an admin can update."
          },
          "response": []
        },
        {
          "name": "Delete Product",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/products/:id",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "products", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "PRODUCT_ID_HERE",
                  "description": "MongoDB ObjectId of the product"
                }
              ]
            },
            "description": "Delete a product. Admin only."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Health & Info",
      "description": "Server health check and API info",
      "item": [
        {
          "name": "API Info",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api",
              "host": ["{{base_url}}"],
              "path": ["api"]
            },
            "description": "Get API info, version, and available endpoints."
          },
          "response": []
        },
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/health",
              "host": ["{{base_url}}"],
              "path": ["api", "health"]
            },
            "description": "Check if the server is healthy and running."
          },
          "response": []
        }
      ]
    }
  ]
}
